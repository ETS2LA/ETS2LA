msgstr "Pakota pelin oma kartan nimi"

msgid ""
"• If you create an account, we transfer your account information to an "
"international recipient."
msgstr ""
"• Jos luot tilin, me siirrämme tilitietosi ulkomaalla sijaitsevalle "
"vastaanottajalle."

#, csharp-format
msgid "Update to {0} from {1}"
msgstr "Päivitä versioon {0} versiosta {1}"

