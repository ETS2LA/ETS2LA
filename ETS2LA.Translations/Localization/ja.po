msgid "Error loading '{0}': {1}"
msgstr "「{0}」の読み込み中にエラーが発生しました: {1}"

msgid ""
"ETS2LA requires you to install our <span class=\"text-text-accent font-"
"bold\">SDK</span> to get started. Please install the SDK for <span "
"class=\"text-text-accent font-bold\">at least one game</span> to continue."
msgstr ""
"ETS2LAを開始するには、<span class=\"text-text-accent font-bold\">SDK</span>を"
"インストールする必要があります。続行するには、<span class=\"text-text-accent "
"font-bold\">少なくとも1つのゲーム</span>にSDKをインストールしてください。"

#, csharp-format
