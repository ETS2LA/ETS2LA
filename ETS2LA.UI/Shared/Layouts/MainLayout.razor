@using ETS2LA.UI.Shared.Overlays
@using ETS2LA.UI.Shared.Components
@using ETS2LA.Logging;
@using ETS2LA.Networking.Settings;

@inherits LayoutComponentBase
@inject IJSRuntime JS

@code {
  string currentVersion = "v" + System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "unknown";
  string subtitle => GetSubtitle();

  private ElementReference scrollArea;
  private ElementReference bottomButtons;

  protected override void OnInitialized()
  {
    base.OnInitialized();
    WindowState.Current.NeedsFullReload += (sender, e) => {
      InvokeAsync(StateHasChanged); 
    };
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      await JS.InvokeVoidAsync("initScrollDivider", scrollArea, bottomButtons);
    }
  }

  private string GetSubtitle()
  {
    if (NetworkingSettings.Current.CurrentUser == null)
      return "";

    if (NetworkingSettings.Current.CurrentUser.Paddle != null)
    {
      Logger.Info($"CurrentUser.Paddle.CustomerId: {NetworkingSettings.Current.CurrentUser.Paddle.CustomerId}");
      var subscription = NetworkingSettings.Current.CurrentUser.Paddle.Subscriptions.FirstOrDefault(s => s.SubscriptionStatus == Networking.Users.SubscriptionStatus.Trialing 
                                                                                                                                || s.SubscriptionStatus == Networking.Users.SubscriptionStatus.Active);
      Logger.Info($"CurrentUser.Paddle.Subscription: {subscription?.SubscriptionId}, Status: {subscription?.SubscriptionStatus.ToString()}");
      if (subscription != null)
      {
        switch (subscription.SubscriptionStatus)
        {
          case Networking.Users.SubscriptionStatus.Trialing:
            return _("Trial");
          case Networking.Users.SubscriptionStatus.Active:
            return _("Subscriber");
        }
      }
    }

    if (NetworkingSettings.Current.CurrentUser.Role != Networking.Users.UserRole.User)
      return NetworkingSettings.Current.CurrentUser.Role.ToString();

    return "";
  }
}

<main class="flex h-screen w-screen flex-col border border-border rounded-md bg-bg">
  <ResizeHandles />
  <Titlebar />
  <Notifications />
    
  <div class="flex p-1.5 h-full w-full">
    <!-- Sidebar -->
    <div class=@((WindowState.Current.IsSidebarOpen ? "w-[210px]" : "w-0") + " transition-all duration-300 ease-in-out pl-1 pr-3 pt-2.5 flex gap-6.5 flex-col h-full")>
      <div class="flex pl-3 flex-col relative">
        <div class=@((WindowState.Current.IsSidebarOpen ? " opacity-100" : " opacity-0") + " transition-opacity duration-100 ease-in-out")>
          <div class="flex items-end gap-0.5">
            <p class="font-bold">ETS2LA</p>
            <p class="text-[12px] mb-px">@subtitle</p>
          </div>
          @try
          {
            <p class="description text-[11px] font-medium -my-0.5">@currentVersion</p>
          }
          catch
          {
            <p class="description text-[11px] font-medium -my-0.5">unknown</p>
          }
        </div>

        <div class="absolute top-0 right-0 w-6 h-6 flex items-center justify-center cursor-pointer" @onclick="() => { WindowState.Current.IsSidebarOpen = !WindowState.Current.IsSidebarOpen; WindowState.Current.RequestFullReload(); }">
          <div class=@((WindowState.Current.IsSidebarOpen ? "w-3 h-[2px] bg-border" : "w-[2px] h-3 bg-border") + " transition-all duration-300 ease-in-out")></div>
        </div>
      </div>

      <div class="flex flex-col flex-1 min-h-0">
        <div @ref="scrollArea" class="flex flex-col gap-6.5 flex-1 min-h-0 overflow-y-auto overflow-x-hidden">
          <div class=@("flex flex-col gap-0" + (WindowState.Current.IsSidebarOpen ? " opacity-100" : " opacity-0") + " transition-opacity duration-200 ease-in-out")>
            <SidebarGroupLabel Title=@(_("Main")) />
            <SidebarButton Name=@(_("Dashboard")) Path="/" Match="NavLinkMatch.All" />
            <SidebarButton Name=@(_("Visualization")) Path="/visualization" />
          </div>

          <div class=@("flex flex-col gap-0" + (WindowState.Current.IsSidebarOpen ? " opacity-100" : " opacity-0") + " transition-opacity duration-200 ease-in-out")>
            <SidebarGroupLabel Title=@(_("Plugins")) />
            <SidebarButton Name=@(_("Manager")) Path="/plugins/manager" />
            <SidebarButton Name=@(_("Catalogue")) Path="/plugins/catalogue" />
          </div>

          <div class=@("flex flex-col gap-0" + (WindowState.Current.IsSidebarOpen ? " opacity-100" : " opacity-0") + " transition-opacity duration-200 ease-in-out")>
            <SidebarGroupLabel Title=@(_("Help")) />
            <SidebarButton Name=@(_("Wiki / FAQ")) Path="/help/wiki" />
            <SidebarButton Name=@(_("Contact Us")) Path="/help/contact" />
            <SidebarButton Name=@(_("Chatbot")) Path="/help/chatbot" />
          </div>
        </div>

        <div @ref="bottomButtons" class=@("flex flex-col w-full gap-0 mb-4 pt-2 border-t border-border" + (WindowState.Current.IsSidebarOpen ? " opacity-100" : " opacity-0") + " transition-opacity duration-200 ease-in-out")>
          <SidebarButton Name=@(_("Settings")) Path="/settings" />
          <SidebarButton Name=@NetworkingSettings.Current.CurrentUser.Username Path="/settings/account" />
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="w-full h-full bg-bg-dark rounded-md rounded-l-lg overflow-y-auto">
      @Body      
    </div>
  </div>
</main>