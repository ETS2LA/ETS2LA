@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    private async Task Toggle()
    {
        Value = !Value;
        await ValueChanged.InvokeAsync(Value);
        await OnToggle.InvokeAsync(Value);
    }
}

<div class="flex flex-col gap-1 @Class">
    <div class="flex justify-between items-center">
        <p>@Title</p>
        <button type="button"
                aria-label="@Title"
                class="cursor-pointer w-12 bg-control h-6 rounded-[8px] @(Value ? "bg-accent-border!" : "")" 
                @onclick="Toggle">
            <div class="ml-1 mr-1 size-[15px] bg-text-l/80 rounded-[6px] transition-all duration-200 @(Value ? "translate-x-[calc(137%)] bg-text-l!" : "")"></div>
        </button>
    </div>
    <p class="description">@Description</p>
</div>