@page "/"
@inject NavigationManager Navigation
@using static ETS2LA.Translations.T

@using Velopack
@using Velopack.Logging
@using Velopack.Sources
@using ETS2LA.Networking.Updates
@using ETS2LA.Notifications

@code {
    List<string> Sponsors = new List<string>
    {
        "AkhtiveLzz",
        "Lun011666",
        "luuukske",
        "McAs13",
        "Private Sponsor",
        "Private Sponsor"
    };

    bool alreadyChecked = false;
    bool sponsorBadgeLoaded = false;
    bool sponsorBadgeFailed = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if(!WindowSettings.Current.HasCompletedOnboarding)
        {
            Navigation.NavigateTo("/onboarding", true);
        }

        if (!alreadyChecked)
            Task.Run(() => CheckForUpdates());
    }

    private void CheckForUpdates()
    {
        NotificationHandler.Current.SendNotification(new ETS2LA.Notifications.Notification{
            Id = "ETS2LA.UI.Settings.Updates.CheckingForUpdates",
            Title = _("Checking for updates..."),
            Content = _("This might take a while depending on your internet connection and the source."),
            IsProgressIndeterminate = true,
        });

        var updateManager = Updater.Current.UpdateManager;
        UpdateInfo? latestUpdateInfo = null;
        try
        {
            latestUpdateInfo = updateManager.CheckForUpdates();
        } 
        catch 
        {
            NotificationHandler.Current.CloseNotification("ETS2LA.UI.Settings.Updates.CheckingForUpdates");
            NotificationHandler.Current.SendNotification(new ETS2LA.Notifications.Notification{
                Id = "ETS2LA.UI.Settings.Updates.ErrorCheckingForUpdates",
                Title = _("Error Checking for Updates"),
                Content = _("An error occurred while checking for updates."),
                IsProgressIndeterminate = false,
                Level = NotificationLevel.Warning
            });
            return;
        }
        alreadyChecked = true;

        if (latestUpdateInfo != null)
        {
            NotificationHandler.Current.CloseNotification("ETS2LA.UI.Settings.Updates.CheckingForUpdates");
            NotificationHandler.Current.SendNotification(new ETS2LA.Notifications.Notification{
                Id = "ETS2LA.UI.Settings.Updates.UpdateAvailable",
                Title = _("Update Available"),
                Content = _("A new update is available: {0}", latestUpdateInfo.TargetFullRelease?.Version.ToString() ?? _("Unknown Version")),
                IsProgressIndeterminate = false,
                Level = NotificationLevel.Warning
            });
        }
        else
        {
            NotificationHandler.Current.CloseNotification("ETS2LA.UI.Settings.Updates.CheckingForUpdates");
            NotificationHandler.Current.SendNotification(new ETS2LA.Notifications.Notification{
                Id = "ETS2LA.UI.Settings.Updates.NoUpdateAvailable",
                Title = _("No Update Available"),
                Content = _("You are running the latest version."),
                IsProgressIndeterminate = false,
                Level = NotificationLevel.Success
            });
        }
    }

    void OpenInBrowser(string url)
    {
        UserInterfaceUtils.OpenUrl(url);
    }

    void OnSponsorBadgeLoaded()
    {
        sponsorBadgeLoaded = true;
        sponsorBadgeFailed = false;
    }

    void OnSponsorBadgeFailed()
    {
        sponsorBadgeLoaded = false;
        sponsorBadgeFailed = true;
    }

    void OpenSponsorPage()
    {
        UserInterfaceUtils.OpenUrl("https://github.com/sponsors/Tumppi066");
    }
}

<div class="flex flex-col p-6 w-130">
    <div class="flex flex-col justify-between rounded-sm bg-control-bg-dark border p-4  border-bg-darker">
        <div class="mt-2 flex flex-col w-full">
            <p>@((MarkupString)(_("Like ETS2LA? Consider supporting us by becoming a <span class=\"font-bold text-text-accent\">GitHub Sponsor</span> to cover ongoing development and operational costs.")))</p>
            <a href="" target="_blank" class="button button-accent mt-4 w-full!" @onclick=@(() => OpenInBrowser("https://github.com/sponsors/Tumppi066"))>@_("Become a GitHub Sponsor")</a>
        </div>
    </div>
    
    <div class="mt-3 ml-4">
        @if (sponsorBadgeFailed)
        {
            <p class="font-semibold description">@(_("Thank you to the following people for their ongoing support:"))</p>
            <ul class="list-disc pl-6 description">
                @foreach (var sponsor in Sponsors)
                {
                    <li>@sponsor</li>
                }
            </ul>
        }
    </div>

    @if (!sponsorBadgeFailed)
    {
        <p class="font-semibold description mt-3 ml-4">@(_("Thank you to the following people for their ongoing support:"))</p>
    }
    <img src="https://readme-contribs.as93.net/sponsors/Tumppi066?perRow=8" alt="sponsors badge" class="@(sponsorBadgeLoaded ? "" : "hidden")" @onload="OnSponsorBadgeLoaded" @onerror="OnSponsorBadgeFailed" @onclick="OpenSponsorPage" style="cursor: pointer;" />
    @if (!sponsorBadgeFailed)
    {
        <p class="description ml-4">@(_("And to those who've decided to remain anonymous!"))</p>
    }
</div>
