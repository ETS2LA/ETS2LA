@page "/settings/audio"
@layout Shared.Layouts.SettingsLayout
@using ETS2LA.UI.Shared.Components
@using ETS2LA.Audio;

@code {
    public float Volume
    {
        get => (float)Math.Round(AudioHandler.Current.GetVolume() * 100, 0);
        set
        {
            if (value != Volume)
            {
                AudioHandler.Current.SetVolume(value / 100);
                if (AudioHandler.Current.GetQueueLength() == 0)
                    AudioHandler.Current.Queue("Assets/Sounds/prompt.mp3");
            }
        }
    }
}

<div class="flex flex-col w-108 m-5 ml-8 gap-6">
    <Slider Title=@(_("Volume"))
            Description=@(_("Adjust the volume of the audio output."))
            Suffix="%"
            Min="0"
            Max="100"
            Value="@Volume"
            ValueChanged="@((float value) => Volume = value)" />
</div>