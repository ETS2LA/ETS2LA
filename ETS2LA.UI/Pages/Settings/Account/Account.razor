@page "/settings/account"
@using ETS2LA.Networking
@using ETS2LA.Networking.Users
@using ETS2LA.Networking.Settings
@using ETS2LA.UI.Shared.Components
@using ETS2LA.Notifications
@using ETS2LA.Logging
@layout Shared.Layouts.SettingsLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS

@code {
    private User? CurrentUser => NetworkingSettings.Current.CurrentUser;

    private string Username { get; set; } = string.Empty;
    private string OtpCode { get; set; } = string.Empty;

    private bool WantsToRemoveAccount { get; set; } = false;
    private bool WantsToDisplayJwtToken { get; set; } = false;
    private bool DisplayJwtToken { get; set; } = false;
    private bool JwtTokenCopied { get; set; } = false;
    
    protected override void OnInitialized()
    {
        if (CurrentUser == null || CurrentUser.JwtToken == null || DateTime.UtcNow >= CurrentUser.Expiry)
        {
            Navigation.NavigateTo("/settings/account/login");
        }
    }

    private async Task Logout()
    {
        try
        {
            bool success = await NetworkingClient.Current.UserClient.Logout(NetworkingSettings.Current.CurrentUser);

            if (!success)
            {
                Logger.Warn($"Logout failed for user {CurrentUser?.Username}. Server did not acknowledge logout.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Logout Failed"),
                    Content = _("Failed to log out. Please try again."),
                    Level = NotificationLevel.Warning
                });
            }
            else
            {
                Logger.Info($"User {CurrentUser?.Username} logged out successfully.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Logout Successful"),
                    Content = _("You have successfully logged out."),
                    Level = NotificationLevel.Success
                });
                NetworkingSettings.Current.CurrentUser = new User();
                NetworkingSettings.Current.Save();
            }
        }
        catch (Exception ex)
        {
            Logger.Error($"An error occurred during logout for user {CurrentUser?.Username}: {ex.Message}");
            NotificationHandler.Current.SendNotification(new Notifications.Notification
            {
                Id = Guid.NewGuid().ToString(),
                Title = _("Logout Error"),
                Content = _("An error occurred while trying to log out. Please try again later. Error: ") + ex.Message,
                Level = NotificationLevel.Danger
            });
        }
    }

    private async Task RemoveAccount()
    {
        try
        {
            bool success = await NetworkingClient.Current.UserClient.RemoveAccount(NetworkingSettings.Current.CurrentUser);

            if (!success)
            {
                Logger.Warn($"Account removal failed for user {CurrentUser?.Username}. Server did not acknowledge removal.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Account Removal Failed"),
                    Content = _("Failed to remove account. Please try again."),
                    Level = NotificationLevel.Warning
                });
            }
            else
            {
                Logger.Info($"User {CurrentUser?.Username} account removed successfully.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Account Removed"),
                    Content = _("Your account has been successfully removed."),
                    Level = NotificationLevel.Success
                });
                NetworkingSettings.Current.CurrentUser = new User();
                NetworkingSettings.Current.Save();
            }
        }
        catch (Exception ex)
        {
            Logger.Error($"An error occurred during account removal for user {CurrentUser?.Username}: {ex.Message}");
            NotificationHandler.Current.SendNotification(new Notifications.Notification
            {
                Id = Guid.NewGuid().ToString(),
                Title = _("Account Removal Error"),
                Content = _("An error occurred while trying to remove your account. Please try again later. Error: ") + ex.Message,
                Level = NotificationLevel.Danger
            });
        }
    }

    private void DialogClosed(bool value)
    {
        if (!value)
        {
            WantsToRemoveAccount = false;
        }
    }

    private async Task CopyJwtToken()
    {
        if (CurrentUser?.JwtToken == null)
        {
            return;
        }

        try
        {
            bool success = await JS.InvokeAsync<bool>("copyToClipboard", CurrentUser.JwtToken);
            if (success)
            {
                JwtTokenCopied = true;
                StateHasChanged();
                await Task.Delay(2000);
                JwtTokenCopied = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.Error($"Failed to copy JWT token to clipboard: {ex.Message}");
        }
    }

    private void OpenSubscriptionPage()
    {
        Navigation.NavigateTo("/subscription/pricing");
    }
}

<div class="flex flex-col w-full p-5 px-8 gap-3">
    @if (CurrentUser != null && CurrentUser.JwtToken != null && DateTime.UtcNow < CurrentUser.Expiry)
    {
        <p class="description">@((MarkupString)_("You are currently logged in as <span class=\"text-text-l\">{0}</span>. [{1}]", CurrentUser.Username, CurrentUser.Role.ToString()))</p>
        <p class="description">@((MarkupString)_("Your token will expire on <span class=\"text-text-l\">{0}</span>, you'll be asked to login again then.", CurrentUser.Expiry.ToLocalTime().ToString("f")))</p>
        
        <button class="button button-accent mt-2" @onclick="OpenSubscriptionPage">@(_("ETS2LA Subscription"))</button>
        <button class="button" @onclick="() => WantsToRemoveAccount = true">@(_("Remove Account"))</button>
        <button class="button" @onclick="Logout">@(_("Logout"))</button>

        <p class="description mt-4">@((MarkupString)_("Some 3rd party websites might want access to your account.<br/>You can press the button below to display your JWT token."))</p>
        <button class="button" @onclick="() => WantsToDisplayJwtToken = true">@(_("Display JWT Token"))</button>
        @if (DisplayJwtToken)
        {
            <p class="description text-text-accent mt-2">@((MarkupString)_("Only copy this to trusted websites, it can do ANYTHING on your behalf."))</p>
            <div class="bg-bg-dark border border-border rounded-md p-2 mt-1 flex items-start gap-2">
                <p class="text-[12px] break-all flex-1">@CurrentUser.JwtToken</p>
                <button class="button shrink-0" @onclick="CopyJwtToken" title="@_("Copy to clipboard")">
                    @if (JwtTokenCopied)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6 9 17l-5-5"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
                            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
                        </svg>
                    }
                </button>
            </div>
        }

        <Dialog Open="@WantsToRemoveAccount" OpenChanged="@(value => DialogClosed(value))" Class="w-full max-w-md">
            <p>@(_("Removing your account will delete all your data from our servers. This action cannot be undone."))</p>
            <button class="button button-accent w-full! mt-3" @onclick="RemoveAccount">@(_("Confirm Account Removal"))</button>
            <p class="description mt-2">@_("Press anywhere outside the dialog to close it.")</p>
        </Dialog>

        <Dialog Open="@WantsToDisplayJwtToken" OpenChanged="@(value => {WantsToDisplayJwtToken = value; DisplayJwtToken = true;})" Class="w-full max-w-md">
            <p>@(_("If you're streaming or recording, now's the time to hide this window."))</p>
            <p class="description mt-2">@_("Press anywhere outside the dialog to close it.")</p>
        </Dialog>
    }
    else
    {
        <p class="description">@(_("You are not logged in. Open this page again to login."))</p>
    }
</div>