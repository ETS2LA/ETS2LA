@page "/help/wiki"

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        
        WindowState.Current.IsSidebarOpen = false;
        WindowState.Current.RequestFullReload();
    }
}

<!-- 
    Insane hacks to make sure that the iframe is scaled down, as the website would be too large otherwise 
    100/90 = 11.11%
-->
<div class="w-full h-full overflow-hidden">
    <iframe src="https://ets2la.com/help/faq" class="w-[111.11%] h-[111.11%] transform scale-90 origin-top-left" style="border: none;"></iframe>
</div>