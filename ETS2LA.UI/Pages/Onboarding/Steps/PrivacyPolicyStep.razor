@using ETS2LA.State;
@using ETS2LA.Logging;
@using static ETS2LA.Translations.Languages;
@using ETS2LA.UI.Shared.Components;
@using ETS2LA.Networking.Updates;


@code {
    // When ETS2LA is downloaded from CNB, it sets the default updater source
    // to CNB, we can detect this to show a different page for Chinese Users.
    public bool IsChina => Updater.Current.GetSelectedSource().sourceName == "CNB";

    [Parameter]
    public Action OnNext { get; set; }

    [Parameter]
    public Action OnPrevious { get; set; }

    private void OpenGlobalPrivacyPolicy()
    {
        UserInterfaceUtils.OpenUrl("https://ets2la.com/#/legal/privacy");
    }

    private void OpenCNPrivacyPolicy()
    {
        UserInterfaceUtils.OpenUrl("https://docs.ets2la.cn/service-privacy");
    }
}

<div class="flex gap-12 text-start items-center justify-center">
    <div class="flex flex-col gap-2 min-w-96 max-w-108">
        <div class="flex flex-col gap-1">
            <h3>@((MarkupString)_("Privacy Policy"))</h3>
            @if(IsChina)
            {
                <p class="text-[14px]">@((MarkupString)(_("• If you create an account, we transfer your account information to an international recipient.")))</p>
                <p class="text-[14px] ml-2">@((MarkupString)(_("• ETS2LA Developers, contact@ets2la.com, Poland.")))</p>
            }
            else
            {
                <p class="description">@((MarkupString)(_("We don't sell or transfer your personal data to any third parties, in fact, we don't even collect it. However, we are still obligated to display and acquire your consent before proceeding.")))</p>
            }
        </div>

        <div class="flex gap-2 mt-2">
            <button class="button w-full!" @onclick="IsChina ? OpenCNPrivacyPolicy : OpenGlobalPrivacyPolicy">@_("Open Externally")</button>
            <button class="button w-full!" @onclick="OnNext">@_("Continue")</button>
        </div>

        @if(IsChina)
        {
            <p class="description mt-1">@((MarkupString)(_("By clicking <span class=\"font-bold\">Continue</span>, you agree to our Privacy Policy.")))</p>
            <p class="description">@((MarkupString)(_("By clicking <span class=\"font-bold\">Continue</span>, you agree to the transfer of your possible account information to an international recipient.")))</p>
        }
        else
        {
            <p class="description">@((MarkupString)(_("By clicking <span class=\"font-bold\">Continue</span>, you agree to our Privacy Policy.")))</p>
        }
    </div>

    <div class="flex flex-col gap-2 w-[450px]">
        @if(IsChina)
        {
            <iframe src="https://docs.ets2la.cn/service-privacy" class="w-[450px] h-[500px] rounded-md border border-border"></iframe>
        }
        else
        {
            <iframe src="https://ets2la.com/?clean#/legal/privacy" class="w-[450px] h-[500px] rounded-md border border-border"></iframe>
        }
    </div>
</div>